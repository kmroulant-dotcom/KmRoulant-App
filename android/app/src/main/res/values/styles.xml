<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>

        <!-- Fond de la fenêtre avant le chargement du JS -->
        <item name="android:windowBackground">@color/kmr_green</item>
        <!-- Barre d'état dès le lancement -->
        <item name="android:statusBarColor">@color/kmr_green</item>
        <!-- Splash système Android 12+ -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/kmr_green</item>
    </style>
</resources>
